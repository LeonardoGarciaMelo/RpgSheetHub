@inherits LayoutComponentBase
@inject ThemeService ThemeService
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row">
            @if (ThemeService.CurrentTheme != RpgTheme.Hub)
            {
                <span class="system-badge-active">
                    ● @GetSystemName(ThemeService.CurrentTheme)
                </span>
            }
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">Docs</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += StateHasChanged;
    }

    private static string GetSystemName(RpgTheme theme) => theme switch
    {
        RpgTheme.DnD => "D&D",
        RpgTheme.Gurps => "GURPS",
        RpgTheme.T20 => "Tormenta 20",
        RpgTheme.OrdemParanormal => "Ordem Paranormal",
        RpgTheme.Pathfinder => "Pathfinder",
        _ => ""
    };

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= StateHasChanged;
    }
}
