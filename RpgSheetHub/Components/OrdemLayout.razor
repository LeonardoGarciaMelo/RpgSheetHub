@using RpgSheetHub.Models

@* ── Abas ─────────────────────────────────────────────────────── *@
<div class="op-tabs">
    @foreach (var tab in Tabs)
    {
        <button class="op-tab @(ActiveTab == tab ? "active" : "")"
                @onclick="() => ActiveTab = tab">
            @tab
        </button>
    }
</div>

@* ============================================================
   ABA 1 — PRINCIPAL
   ============================================================ *@
@if (ActiveTab == "Principal")
{
<div class="op-sheet">

    @* Cabeçalho *@
    <div class="op-header">
        <div class="op-field op-field-lg">
            <input type="text" @bind="Sheet.CharacterName" placeholder=" " />
            <label>Personagem</label>
        </div>
        <div class="op-field op-field-lg">
            <input type="text" value="@V("jogador")" @onchange='e=>S("jogador",e.Value)' placeholder=" " />
            <label>Jogador(a)</label>
        </div>
        <div class="op-field op-field-lg">
            <input type="text" value="@V("origem")" @onchange='e=>S("origem",e.Value)' placeholder=" " />
            <label>Origem</label>
        </div>
        <div class="op-field op-field-lg">
            <input type="text" value="@V("classe")" @onchange='e=>S("classe",e.Value)' placeholder=" " />
            <label>Classe</label>
        </div>
        <div class="op-field op-field-lg">
            <input type="text" value="@V("elemento")" @onchange='e=>S("elemento",e.Value)' placeholder=" " />
            <label>Elemento</label>
        </div>
        <div class="op-field op-field-lg">
            <input type="text" value="@V("trilha")" @onchange='e=>S("trilha",e.Value)' placeholder=" " />
            <label>Trilha</label>
        </div>
        <div class="op-field op-field-lg">
            <input type="text" value="@V("patente")" @onchange='e=>S("patente",e.Value)' placeholder="Recruta" />
            <label>Patente</label>
        </div>
        <div class="op-field op-field-sm">
            <input type="text" value="@V("nex")" @onchange='e=>S("nex",e.Value)' placeholder="5%" />
            <label>NEX</label>
        </div>
        <div class="op-field op-field-sm">
            <input type="number" value="@V("xp")" @onchange='e=>S("xp",e.Value)' placeholder="0" />
            <label>XP</label>
        </div>
        <div class="op-field op-field-sm">
            <input type="number" value="@V("pm")" @onchange='e=>S("pm",e.Value)' placeholder="0" />
            <label>PM</label>
        </div>
    </div>

    @* Corpo: atributos | status+combate | perícias *@
    <div class="op-body">

        @* ── Coluna Esquerda: Atributos ── *@
        <div class="op-col-attrs">
            <div class="op-attrs-title">Atributos</div>
            <div class="op-attrs-grid">
                @foreach (var attr in Attrs)
                {
                    var val = IZero(attr.Key);
                    <div class="op-attr-hex">
                        <div class="op-attr-key">@attr.Short</div>
                        <input type="number" class="op-attr-val"
                               value="@val"
                               @onchange='e=>S(attr.Key, e.Value)'
                               min="-5" max="20" />
                        <div class="op-attr-label">@attr.Label</div>
                    </div>
                }
            </div>
        </div>

        @* ── Coluna Central: Status + Defesa + Ataques ── *@
        <div class="op-col-center">

            @* Status vital *@
            <div class="op-status-grid">
                <div class="op-status-box op-pv">
                    <label class="op-status-label">PV — Pontos de Vida</label>
                    <div class="op-status-row">
                        <input type="number" value="@V("pv_atual")" @onchange='e=>S("pv_atual",e.Value)' placeholder="0" />
                        <span class="op-status-sep">/</span>
                        <input type="number" value="@V("pv_max")" @onchange='e=>S("pv_max",e.Value)' placeholder="0" />
                    </div>
                    <div class="op-status-hint">atual / máximo</div>
                </div>
                <div class="op-status-box op-pe">
                    <label class="op-status-label">PE — Pontos de Esforço</label>
                    <div class="op-status-row">
                        <input type="number" value="@V("pe_atual")" @onchange='e=>S("pe_atual",e.Value)' placeholder="0" />
                        <span class="op-status-sep">/</span>
                        <input type="number" value="@V("pe_max")" @onchange='e=>S("pe_max",e.Value)' placeholder="0" />
                    </div>
                    <div class="op-status-hint">atual / máximo</div>
                </div>
                <div class="op-status-box op-san">
                    <label class="op-status-label">SAN — Sanidade</label>
                    <div class="op-status-row">
                        <input type="number" value="@V("san_atual")" @onchange='e=>S("san_atual",e.Value)' placeholder="0" />
                        <span class="op-status-sep">/</span>
                        <input type="number" value="@V("san_max")" @onchange='e=>S("san_max",e.Value)' placeholder="0" />
                    </div>
                    <div class="op-status-hint">atual / máximo</div>
                </div>
            </div>

            @* Defesa + Deslocamento + PE/Rodada *@
            <div class="op-combat-grid">
                <div class="op-combat-box">
                    <div class="op-combat-formula">
                        10 + @FVal("agi") (AGI) + 
                        <input type="number" class="op-inline-input"
                               value="@V("defesa_equip")" @onchange='e=>S("defesa_equip",e.Value)'
                               placeholder="0" title="Equipamento" />
                        +
                        <input type="number" class="op-inline-input"
                               value="@V("defesa_outros")" @onchange='e=>S("defesa_outros",e.Value)'
                               placeholder="0" title="Outros" />
                        = <strong>@Defesa()</strong>
                    </div>
                    <label>Defesa</label>
                </div>
                <div class="op-combat-box">
                    <input type="number" value="@V("deslocamento")" @onchange='e=>S("deslocamento",e.Value)' />
                    <label>Deslocamento (m)</label>
                </div>
                <div class="op-combat-box">
                    <input type="number" value="@V("pe_rodada")" @onchange='e=>S("pe_rodada",e.Value)' />
                    <label>PE / Rodada</label>
                </div>
            </div>

            @* Proteção e Resistências *@
            <div class="op-resist-box">
                <div class="op-resist-row">
                    <label>Proteção</label>
                    <input type="text" value="@V("protecao")" @onchange='e=>S("protecao",e.Value)'
                           placeholder="Ex: Proteção Leve 3" />
                </div>
                <div class="op-resist-row">
                    <label>Resistências</label>
                    <input type="text" value="@V("resistencias")" @onchange='e=>S("resistencias",e.Value)'
                           placeholder="Ex: Balística 2, Fogo 3" />
                </div>
            </div>

            @* Ataques *@
            <div class="op-attacks-box">
                <div class="op-section-title">Ataques</div>
                <div class="op-attacks-header">
                    <span style="flex:2">Arma</span>
                    <span style="flex:1">Teste</span>
                    <span style="flex:1">Dano</span>
                    <span style="flex:2">Crítico / Alcance / Especial</span>
                    <span style="width:26px"></span>
                </div>
                @for (int i = 0; i < Attacks.Count; i++)
                {
                    var idx = i;
                    var atk = Attacks[idx];
                    <div class="op-attack-row">
                        <input style="flex:2" type="text" value="@atk.Arma"    @onchange='e=>atk.Arma=e.Value?.ToString()??""'    placeholder="Adaga" />
                        <input style="flex:1" type="text" value="@atk.Teste"   @onchange='e=>atk.Teste=e.Value?.ToString()??""'   placeholder="3d20" />
                        <input style="flex:1" type="text" value="@atk.Dano"    @onchange='e=>atk.Dano=e.Value?.ToString()??""'    placeholder="1d4" />
                        <input style="flex:2" type="text" value="@atk.Especial" @onchange='e=>atk.Especial=e.Value?.ToString()??""' placeholder="19/×2 Curto Discreta" />
                        <button class="op-del-btn" @onclick='()=>Attacks.RemoveAt(idx)'>✕</button>
                    </div>
                }
                <button class="op-add-btn" @onclick="()=>Attacks.Add(new AttackEntry())">+ Ataque</button>
            </div>

        </div>

        @* ── Coluna Direita: Perícias ── *@
        <div class="op-col-skills">
            <div class="op-section-title">Perícias</div>
            <div class="op-skills-header">
                <span class="sk-name">Perícia</span>
                <span class="sk-attr">Attr</span>
                <span class="sk-treino">Treino</span>
                <span class="sk-outros">Outros</span>
                <span class="sk-total">Total</span>
            </div>
            @foreach (var sk in Skills)
            {
                var attrVal = IZero(sk.Attr);
                var treino  = IZero($"sk_treino_{sk.Key}");
                var outros  = IZero($"sk_outros_{sk.Key}");
                var total   = attrVal + treino + outros;
                <div class="op-skill-row">
                    <span class="sk-name @(sk.SomenteTreinada ? "sk-trained-only" : "")">
                        @sk.Label@(sk.SomenteTreinada ? "*" : "")
                    </span>
                    <span class="sk-attr">@sk.AttrLabel</span>
                    <input class="sk-treino" type="number"
                           value="@treino"
                           @onchange='e=>S($"sk_treino_{sk.Key}",e.Value)'
                           min="0" />
                    <input class="sk-outros" type="number"
                           value="@outros"
                           @onchange='e=>S($"sk_outros_{sk.Key}",e.Value)' />
                    <span class="sk-total @(total > 0 ? "sk-positive" : "")">@FVal(total)</span>
                </div>
            }
            <div class="op-skills-hint">* Somente treinada</div>
        </div>

    </div>
</div>
}

@* ============================================================
   ABA 2 — HABILIDADES & RITUAIS
   ============================================================ *@
@if (ActiveTab == "Habilidades & Rituais")
{
<div class="op-sheet">

    <div class="op-hab-header">
        <div class="op-field">
            <input type="text" value="@V("ritual_atributo")" @onchange='e=>S("ritual_atributo",e.Value)' placeholder="Presença" />
            <label>Atributo-Chave de Rituais</label>
        </div>
        <div class="op-field">
            <input type="number" value="@V("ritual_mod")" @onchange='e=>S("ritual_mod",e.Value)' />
            <label>Mod. do Atributo</label>
        </div>
        <div class="op-field">
            <input type="number" value="@V("ritual_dt")" @onchange='e=>S("ritual_dt",e.Value)' />
            <label>DT de Rituais</label>
        </div>
        <div class="op-field">
            <input type="number" value="@V("ritual_teste_resist")" @onchange='e=>S("ritual_teste_resist",e.Value)' />
            <label>Teste de Resistência</label>
        </div>
    </div>

    @* Habilidades *@
    <div class="op-section-title" style="margin-bottom:8px;">Habilidades</div>
    <div class="op-hab-table-header">
        <span style="flex:2">Habilidade</span>
        <span style="flex:0.5">Custo</span>
        <span style="flex:0.5">Página</span>
        <span style="flex:3">Descritivo</span>
        <span style="width:26px"></span>
    </div>
    @for (int i = 0; i < Habilities.Count; i++)
    {
        var idx = i;
        var hab = Habilities[idx];
        <div class="op-hab-row">
            <input style="flex:2"   type="text" value="@hab.Nome"      @onchange='e=>hab.Nome=e.Value?.ToString()??""'      placeholder="Nome..." />
            <input style="flex:0.5" type="text" value="@hab.Custo"     @onchange='e=>hab.Custo=e.Value?.ToString()??""'     placeholder="1PE" />
            <input style="flex:0.5" type="text" value="@hab.Pagina"    @onchange='e=>hab.Pagina=e.Value?.ToString()??""'    placeholder="42" />
            <input style="flex:3"   type="text" value="@hab.Descritivo" @onchange='e=>hab.Descritivo=e.Value?.ToString()??""' placeholder="Descrição..." />
            <button class="op-del-btn" @onclick='()=>Habilities.RemoveAt(idx)'>✕</button>
        </div>
    }
    <button class="op-add-btn" @onclick="()=>Habilities.Add(new HabilityEntry())">+ Habilidade</button>

    <div style="height:1rem;"></div>

    @* Rituais *@
    <div class="op-section-title" style="margin-bottom:8px;">Rituais Conhecidos</div>
    <div class="op-ritual-table-header">
        <span style="flex:2">Ritual</span>
        <span style="flex:1">Elemento</span>
        <span style="flex:1">Execução</span>
        <span style="flex:1">Alcance</span>
        <span style="flex:1">Área</span>
        <span style="flex:1">Duração</span>
        <span style="flex:1">Resistência</span>
        <span style="flex:2">Efeito</span>
        <span style="width:26px"></span>
    </div>
    @for (int i = 0; i < Rituals.Count; i++)
    {
        var idx = i;
        var rit = Rituals[idx];
        <div class="op-ritual-row @(rit.Expanded ? "is-open" : "")">
            <div class="op-ritual-main">
                <input style="flex:2" type="text" value="@rit.Nome"       @onchange='e=>rit.Nome=e.Value?.ToString()??""'       placeholder="Nome do ritual" />
                <input style="flex:1" type="text" value="@rit.Elemento"   @onchange='e=>rit.Elemento=e.Value?.ToString()??""'   placeholder="Morte" />
                <input style="flex:1" type="text" value="@rit.Execucao"   @onchange='e=>rit.Execucao=e.Value?.ToString()??""'   placeholder="1 ação" />
                <input style="flex:1" type="text" value="@rit.Alcance"    @onchange='e=>rit.Alcance=e.Value?.ToString()??""'    placeholder="Curto" />
                <input style="flex:1" type="text" value="@rit.Area"       @onchange='e=>rit.Area=e.Value?.ToString()??""'       placeholder="—" />
                <input style="flex:1" type="text" value="@rit.Duracao"    @onchange='e=>rit.Duracao=e.Value?.ToString()??""'    placeholder="Cena" />
                <input style="flex:1" type="text" value="@rit.Resistencia" @onchange='e=>rit.Resistencia=e.Value?.ToString()??""' placeholder="Vontade" />
                <input style="flex:2" type="text" value="@rit.Efeito"     @onchange='e=>rit.Efeito=e.Value?.ToString()??""'     placeholder="Resumo..." />
                <button class="spell-expand-btn" style="flex-shrink:0;" @onclick="()=>rit.Expanded=!rit.Expanded">
                    @(rit.Expanded ? "▲" : "▼")
                </button>
                <button class="op-del-btn" @onclick='()=>Rituals.RemoveAt(idx)'>✕</button>
            </div>
            @if (rit.Expanded)
            {
                <div class="op-ritual-body">
                    <label class="op-ritual-desc-label">Descrição Completa</label>
                    <textarea class="op-ritual-desc"
                              @bind="rit.Descricao" @bind:event="oninput" rows="4"
                              placeholder="Cole aqui a descrição completa do ritual..."></textarea>
                </div>
            }
        </div>
    }
    <button class="op-add-btn" @onclick="()=>Rituals.Add(new RitualEntry())">+ Ritual</button>

</div>
}

@* ============================================================
   ABA 3 — INVENTÁRIO
   ============================================================ *@
@if (ActiveTab == "Inventário")
{
<div class="op-sheet">

    @* Meta do inventário *@
    <div class="op-inv-meta">
        <div class="op-field">
            <input type="text" value="@V("patente_inv")" @onchange='e=>S("patente_inv",e.Value)' placeholder="Recruta" />
            <label>Patente</label>
        </div>
        <div class="op-field">
            <input type="number" value="@V("pontos_prestigio")" @onchange='e=>S("pontos_prestigio",e.Value)' />
            <label>Pontos de Prestígio</label>
        </div>
        <div class="op-field">
            <input type="text" value="@V("limite_credito")" @onchange='e=>S("limite_credito",e.Value)' placeholder="—" />
            <label>Limite de Crédito</label>
        </div>
        <div class="op-field">
            <input type="number" value="@V("carga_max")" @onchange='e=>S("carga_max",e.Value)' />
            <label>Carga Máx.</label>
        </div>
        <div class="op-field">
            <input type="number" value="@V("carga_atual")" @onchange='e=>S("carga_atual",e.Value)' />
            <label>Carga Atual</label>
        </div>
    </div>

    @* Limite de itens por tier *@
    <div class="op-tier-box">
        <label class="op-section-title" style="margin-bottom:6px;">Limite de Itens por Tier</label>
        <div class="op-tier-grid">
            @foreach (var tier in new[]{("I","tier_i"),("II","tier_ii"),("III","tier_iii"),("IV","tier_iv")})
            {
                <div class="op-tier-cell">
                    <div class="op-tier-label">Tier @tier.Item1</div>
                    <input type="number" value="@V(tier.Item2)" @onchange='e=>S(tier.Item2,e.Value)' min="0" />
                </div>
            }
        </div>
    </div>

    @* Lista de itens *@
    <div class="op-section-title" style="margin:10px 0 6px;">Itens</div>
    <div class="op-inv-header">
        <span style="flex:3">Item</span>
        <span style="flex:1">Categoria</span>
        <span style="flex:0.5">Espaços</span>
        <span style="width:26px"></span>
    </div>
    @for (int i = 0; i < InvItems.Count; i++)
    {
        var idx = i;
        var it  = InvItems[idx];
        <div class="op-inv-row">
            <input style="flex:3"   type="text" value="@it.Nome"      @onchange='e=>it.Nome=e.Value?.ToString()??""'      placeholder="Nome do item..." />
            <input style="flex:1"   type="text" value="@it.Categoria" @onchange='e=>it.Categoria=e.Value?.ToString()??""' placeholder="Arma, Proteção..." />
            <input style="flex:0.5" type="number" value="@it.Espacos" @onchange='e=>it.Espacos=e.Value?.ToString()??""'  placeholder="1" />
            <button class="op-del-btn" @onclick='()=>InvItems.RemoveAt(idx)'>✕</button>
        </div>
    }
    <button class="op-add-btn" @onclick="()=>InvItems.Add(new InvItemEntry())">+ Item</button>

</div>
}

@* ============================================================
   ABA 4 — DESCRIÇÃO
   ============================================================ *@
@if (ActiveTab == "Descrição")
{
<div class="op-sheet">
    <div class="op-desc-grid">
        <div class="op-desc-box">
            <label class="op-section-title">Aparência</label>
            <textarea @bind="AparenciaValue" @bind:event="oninput"
                      placeholder="Descreva a aparência física do personagem..."></textarea>
        </div>
        <div class="op-desc-box">
            <label class="op-section-title">Personalidade</label>
            <textarea @bind="PersonalidadeValue" @bind:event="oninput"
                      placeholder="Como o personagem age, seus trejeitos, medos..."></textarea>
        </div>
        <div class="op-desc-box" style="grid-column: span 2;">
            <label class="op-section-title">Histórico</label>
            <textarea @bind="HistoricoValue" @bind:event="oninput" style="min-height:140px;"
                      placeholder="Background, como chegou à Ordem, eventos marcantes..."></textarea>
        </div>
        <div class="op-desc-box">
            <label class="op-section-title">Objetivo</label>
            <textarea @bind="ObjetivoValue" @bind:event="oninput"
                      placeholder="O que o agente busca, sua motivação..."></textarea>
        </div>
        <div class="op-desc-box">
            <label class="op-section-title">Anotações</label>
            <textarea @bind="AnotacoesValue" @bind:event="oninput"
                      placeholder="Notas livres, progressão, relacionamentos..."></textarea>
        </div>
    </div>
</div>
}

@* ============================================================
   ABA 5 — MISSÕES
   ============================================================ *@
@if (ActiveTab == "Missões")
{
<div class="op-sheet">

    <div class="op-missions-meta">
        <div class="op-field">
            <input type="number" value="@V("pontos_prestigio_miss")" @onchange='e=>S("pontos_prestigio_miss",e.Value)' />
            <label>Pontos de Prestígio</label>
        </div>
        <div class="op-field">
            <input type="number" value="@V("num_missoes")" @onchange='e=>S("num_missoes",e.Value)' />
            <label>Nº de Missões</label>
        </div>
    </div>

    <div class="op-section-title" style="margin-bottom:8px;">Lista de Missões</div>
    @for (int i = 0; i < Missions.Count; i++)
    {
        var idx = i;
        var mis = Missions[idx];
        <div class="op-mission-card @(mis.Expanded ? "is-open" : "")">
            <div class="op-mission-top">
                <span class="op-mission-num">@(idx + 1).)</span>
                <input class="op-mission-title-input" type="text"
                       value="@mis.Titulo"
                       @onchange='e=>mis.Titulo=e.Value?.ToString()??""'
                       placeholder="Título da missão" />
                <input class="op-mission-meta-input" type="text"
                       value="@mis.Recompensas"
                       @onchange='e=>mis.Recompensas=e.Value?.ToString()??""'
                       placeholder="NEX / XP / PM / PP ganhos" />
                <button class="spell-expand-btn" @onclick="()=>mis.Expanded=!mis.Expanded">
                    @(mis.Expanded ? "▲ Recolher" : "▼ Ações")
                </button>
                <button class="op-del-btn" @onclick='()=>Missions.RemoveAt(idx)'>✕</button>
            </div>
            @if (mis.Expanded)
            {
                <div class="op-mission-body">
                    <label>Ações realizadas</label>
                    <textarea @bind="mis.Acoes" @bind:event="oninput" rows="4"
                              placeholder="Descreva as ações tomadas nesta missão..."></textarea>
                </div>
            }
        </div>
    }
    <button class="op-add-btn" @onclick="()=>Missions.Add(new MissionEntry())">+ Missão</button>

    <div style="height:1.5rem;"></div>
    <div class="op-section-title" style="margin-bottom:8px;">Tempo entre Missões</div>
    <div class="op-field" style="max-width:120px; margin-bottom:1rem;">
        <input type="number" value="@V("tempo_missoes_num")" @onchange='e=>S("tempo_missoes_num",e.Value)' />
        <label>Número</label>
    </div>
    @for (int i = 0; i < DowntimeActions.Count; i++)
    {
        var idx = i;
        var dt  = DowntimeActions[idx];
        <div class="op-downtime-row">
            <span class="op-downtime-num">@(idx+1).</span>
            <input style="flex:1" type="text" value="@dt.Acao"      @onchange='e=>dt.Acao=e.Value?.ToString()??""'      placeholder="Ação..." />
            <input style="flex:1" type="text" value="@dt.Descricao" @onchange='e=>dt.Descricao=e.Value?.ToString()??""' placeholder="Descrição / Número..." />
            <button class="op-del-btn" @onclick='()=>DowntimeActions.RemoveAt(idx)'>✕</button>
        </div>
    }
    <button class="op-add-btn" @onclick="()=>DowntimeActions.Add(new DowntimeEntry())">+ Ação</button>

</div>
}

@* ============================================================
   CSS
   ============================================================ *@
<style>
    /* ── Abas ─────────────────────────────────────────── */
    .op-tabs { display:flex; gap:4px; margin-bottom:1rem; border-bottom:2px solid #6a3fa0; }
    .op-tab {
        font-family:'Cinzel',serif; font-size:0.68rem; font-weight:600;
        letter-spacing:0.08em; text-transform:uppercase;
        padding:0.45rem 1rem; background:transparent;
