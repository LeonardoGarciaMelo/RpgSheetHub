    }

    private static int    Mod(int score) => (int)Math.Floor((score - 10) / 2.0);
    private static string FMod(int m)    => m >= 0 ? $"+{m}" : $"{m}";

    private int SaveMod(string attrKey)
    {
        var base_ = Mod(I(attrKey));
        return Bool($"save_{attrKey}") ? base_ + IZero("prof_bonus") : base_;
    }

