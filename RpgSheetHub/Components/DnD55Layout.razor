@using RpgSheetHub.Models

@* Navigation tabs *@
<div class="sheet-tabs">
    @foreach (var tab in Tabs)
    {
        <button class="sheet-tab @(ActiveTab == tab ? "active" : "")"
                @onclick="() => ActiveTab = tab">
            @tab
        </button>
    }
</div>

@* Main *@
@if (ActiveTab == "Principal")
{
<div class="dnd-sheet">

    @* Header *@
    <div class="dnd-header">
        <div class="dnd-field dnd-name-field">
            <input type="text" @bind="Sheet.CharacterName" placeholder=" " />
            <label>Nome do Personagem</label>
        </div>
        <div class="dnd-field">
            <input type="text" value="@V("antecedente")" @onchange='e=>S("antecedente",e.Value)' placeholder=" " />
            <label>Antecedente</label>
        </div>
        <div class="dnd-field">
            <input type="text" value="@V("classe")" @onchange='e=>S("classe",e.Value)' placeholder=" " />
            <label>Classe</label>
        </div>
        <div class="dnd-field">
            <input type="text" value="@V("especie")" @onchange='e=>S("especie",e.Value)' placeholder=" " />
            <label>Espécie</label>
        </div>
        <div class="dnd-field">
            <input type="text" value="@V("subclasse")" @onchange='e=>S("subclasse",e.Value)' placeholder=" " />
            <label>Subclasse</label>
        </div>
        <div class="dnd-field dnd-field-sm">
            <input type="number" value="@V("nivel")" @onchange='e=>S("nivel",e.Value)' placeholder=" " />
            <label>Nível</label>
        </div>
        <div class="dnd-field dnd-field-sm">
            <input type="number" value="@V("xp")" @onchange='e=>S("xp",e.Value)' placeholder=" " />
            <label>XP</label>
        </div>
    </div>

    <div class="dnd-body">

        @* Left Column: Attributes + Safeguard *@
        <div class="dnd-col-left">
            <div class="dnd-row-2">
                <div class="dnd-stat-box">
                    <input type="number" value="@V("prof_bonus")" @onchange='e=>S("prof_bonus",e.Value)' />
                    <label>Bônus de Proficiência</label>
                </div>
                <div class="dnd-stat-box">
                    <input type="number" value="@V("inspiracao")" @onchange='e=>S("inspiracao",e.Value)' />
                    <label>Inspiração Heroica</label>
                </div>
            </div>

            @foreach (var a in Attrs)
            {
                var score = I(a.Key);
                var mod   = Mod(score);
                <div class="dnd-attr-block">
                    <div class="dnd-attr-name">@a.Label</div>
                    <div class="dnd-attr-inner">
                        <input type="number" class="dnd-attr-score"
                               value="@score" @onchange='e=>S(a.Key, e.Value)'
                               min="1" max="30" />
                        <div class="dnd-attr-mod">@FMod(mod)</div>
                    </div>
                    <div class="dnd-save-inline">
                        <span class="dnd-circle @(Bool($"save_{a.Key}") ? "filled" : "")"
                              @onclick='()=>Toggle($"save_{a.Key}")'></span>
                        <span class="dnd-save-val">@FMod(SaveMod(a.Key))</span>
                        <span class="dnd-save-lbl">Salvaguarda</span>
                    </div>
                </div>
            }

            <div class="dnd-passive-box">
                <span class="dnd-passive-val">@(10 + Mod(I("wisdom")) + (Bool("prof_perception") ? IZero("prof_bonus") : 0))</span>
                <span class="dnd-passive-lbl">Percepção Passiva</span>
            </div>
        </div>

        @* Central Column: Combat + HP + Skills *@
        <div class="dnd-col-center">
            <div class="dnd-combat-row">
                <div class="dnd-combat-box">
                    <input type="number" value="@V("ca")" @onchange='e=>S("ca",e.Value)' />
                    <label>Classe de Armadura</label>
                </div>
                <div class="dnd-combat-box">
                    <input type="number" value="@V("iniciativa")" @onchange='e=>S("iniciativa",e.Value)' />
                    <label>Iniciativa</label>
                </div>
                <div class="dnd-combat-box">
                    <input type="number" value="@V("deslocamento")" @onchange='e=>S("deslocamento",e.Value)' />
                    <label>Deslocamento</label>
                </div>
                <div class="dnd-combat-box">
                    <input type="text" value="@V("tamanho")" @onchange='e=>S("tamanho",e.Value)' />
                    <label>Tamanho</label>
                </div>
            </div>

            <div class="dnd-hp-block">
                <div class="dnd-hp-row">
                    <div class="dnd-hp-sub">
                        <label>Máximo</label>
                        <input type="number" value="@V("hp_max")" @onchange='e=>S("hp_max",e.Value)' />
                    </div>
                    <div class="dnd-hp-sub">
                        <label>Atual</label>
                        <input type="number" value="@V("hp_atual")" @onchange='e=>S("hp_atual",e.Value)' />
                    </div>
                    <div class="dnd-hp-sub">
                        <label>Temp</label>
                        <input type="number" value="@V("hp_temp")" @onchange='e=>S("hp_temp",e.Value)' />
                    </div>
                </div>
                <label class="dnd-section-label">Pontos de Vida</label>
            </div>

            <div class="dnd-row-2">
                <div class="dnd-box-inner">
                    <label class="dnd-section-label">Dados de Vida</label>
                    <div style="display:flex;gap:6px;">
                        <div style="flex:1">
                            <input type="text" value="@V("hit_dice_tipo")" @onchange='e=>S("hit_dice_tipo",e.Value)' placeholder="d8" style="text-align:center;" />
                            <label style="font-size:0.55rem;color:#6b4c28;">Tipo</label>
                        </div>
                        <div style="flex:1">
                            <input type="number" value="@V("hit_dice_gasto")" @onchange='e=>S("hit_dice_gasto",e.Value)' placeholder="0" style="text-align:center;" />
                            <label style="font-size:0.55rem;color:#6b4c28;">Gastos</label>
                        </div>
                    </div>
                </div>
                <div class="dnd-box-inner">
                    <label class="dnd-section-label">Salv. Contra Morte</label>
                    <div class="dnd-death-row">
                        <span style="font-size:0.6rem;color:#6b4c28;">Sucessos</span>
                        @for (int i = 0; i < 3; i++) { var idx = i;
                            <span class="dnd-circle @(Bool($"death_suc_{idx}") ? "filled" : "")"
                                  @onclick='()=>Toggle($"death_suc_{idx}")'></span>
                        }
                    </div>
                    <div class="dnd-death-row">
                        <span style="font-size:0.6rem;color:#6b4c28;">Falhas</span>
                        @for (int i = 0; i < 3; i++) { var idx = i;
                            <span class="dnd-circle danger @(Bool($"death_fail_{idx}") ? "filled" : "")"
                                  @onclick='()=>Toggle($"death_fail_{idx}")'></span>
                        }
                    </div>
                </div>
            </div>

            <div class="dnd-skills-box">
                <label class="dnd-section-label">Perícias</label>
                @foreach (var sk in Skills)
                {
                    var baseAttr = Mod(I(sk.Attr));
                    var prof     = Bool($"prof_{sk.Key}");
                    var expert   = Bool($"expert_{sk.Key}");
                    var bonus    = baseAttr + (prof ? IZero("prof_bonus") : 0);
                    var skKey    = sk.Key;
                    <div class="dnd-skill-row">
                        <span class="dnd-circle @(prof ? "filled" : "")"
                              @onclick='()=>CycleProf(skKey)'
                              @onclick:stopPropagation></span>
                        <span class="dnd-skill-val">@FMod(bonus)</span>
                        <span class="dnd-skill-name">@sk.Label</span>
                        <span class="dnd-skill-attr">(@sk.AttrLabel)</span>
                    </div>
                }
            </div>
        </div>

        @* Right Column: Weapons + Characteristics + Traits *@
        <div class="dnd-col-right">

            @* Weapons *@
            <div class="dnd-section-box">
                <div class="weapon-list-title">
                    <span>Armas</span>
                    <button class="btn-add-spell" @onclick="AddWeapon">+ Adicionar Arma</button>
                </div>

                @for (int i = 0; i < Weapons.Count; i++)
                {
                    var idx = i;
                    var wp  = Weapons[idx];

                    <div class="weapon-card @(wp.Expanded ? "is-open" : "")">
                        <div class="weapon-card-top">
                            <input class="weapon-input-name" type="text"
                                   value="@wp.Nome"
                                   @onchange='e=>wp.Nome=e.Value?.ToString()??""'
                                   placeholder="Nome da arma" />

                            <input class="weapon-input-sm" type="text"
                                   value="@wp.TesteAtaque"
                                   @onchange='e=>wp.TesteAtaque=e.Value?.ToString()??""'
                                   placeholder="d20+5" />

                            <input class="weapon-input-sm" type="text"
                                   value="@wp.Dano"
                                   @onchange='e=>wp.Dano=e.Value?.ToString()??""'
                                   placeholder="1d8+3" />

                            <button class="spell-expand-btn" @onclick="()=>wp.Expanded=!wp.Expanded">
                                @(wp.Expanded ? "▲ Recolher" : "▼ Detalhes")
                            </button>

                            <button class="spell-del-btn" @onclick='()=>Weapons.RemoveAt(idx)'>✕</button>
                        </div>

                        @* Details *@
                        @if (wp.Expanded)
                        {
                            <div class="weapon-card-body">
                                <div class="weapon-meta-grid">
                                    <div class="spell-meta-field">
                                        <label>Crítico</label>
                                        <input type="text" value="@wp.Critico"
                                               @onchange='e=>wp.Critico=e.Value?.ToString()??""'
                                               placeholder="19-20 / ×2" />
                                    </div>
                                    <div class="spell-meta-field">
                                        <label>Tipo de Dano</label>
                                        <input type="text" value="@wp.TipoDano"
                                               @onchange='e=>wp.TipoDano=e.Value?.ToString()??""'
                                               placeholder="Cortante" />
                                    </div>
                                    <div class="spell-meta-field">
                                        <label>Propriedades</label>
                                        <input type="text" value="@wp.Propriedades"
                                               @onchange='e=>wp.Propriedades=e.Value?.ToString()??""'
                                               placeholder="Versátil, Leve..." />
                                    </div>
                                    <div class="spell-meta-field">
                                        <label>Maestria</label>
                                        <input type="text" value="@wp.Maestria"
                                               @onchange='e=>wp.Maestria=e.Value?.ToString()??""'
                                               placeholder="Drenar, Ágil..." />
                                    </div>
                                    <div class="spell-meta-field">
                                        <label>Alcance</label>
                                        <input type="text" value="@wp.Alcance"
                                               @onchange='e=>wp.Alcance=e.Value?.ToString()??""'
                                               placeholder="1,5m / 18m" />
                                    </div>
                                </div>
                                <div class="spell-desc-block">
                                    <label class="spell-desc-label">Poder / Observações especiais</label>
                                    <textarea class="spell-desc-area"
                                              @bind="wp.Observacoes"
                                              @bind:event="oninput"
                                              rows="3"
                                              placeholder="Poderes especiais, efeitos mágicos, notas..."></textarea>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (Weapons.Count == 0)
                {
                    <div class="spell-empty" style="padding:1rem;">
                        Nenhuma arma. Clique em <strong>+ Adicionar Arma</strong>.
                    </div>
                }
            </div>

            <div class="dnd-section-box dnd-grow">
                <label class="dnd-section-label">Características de Classe</label>
                <textarea class="dnd-textarea-grow" @bind="CaracteristicasValue" @bind:event="oninput"
                          placeholder="Liste suas características de classe aqui..."></textarea>
            </div>

            <div class="dnd-row-2">
                <div class="dnd-section-box dnd-grow">
                    <label class="dnd-section-label">Traço de Espécie</label>
                    <textarea class="dnd-textarea-grow" @bind="TracosValue" @bind:event="oninput"
                              placeholder="Traços raciais..."></textarea>
                </div>
                <div class="dnd-section-box dnd-grow">
                    <label class="dnd-section-label">Talentos</label>
                    <textarea class="dnd-textarea-grow" @bind="TalentosValue" @bind:event="oninput"
                              placeholder="Feats e talentos..."></textarea>
                </div>
            </div>

            <div class="dnd-section-box">
                <label class="dnd-section-label">Treinamento e Proficiência em Equipamentos</label>
                <textarea class="dnd-textarea-sm" @bind="TreinamentoValue" @bind:event="oninput"
                          placeholder="Armaduras, armas, ferramentas..."></textarea>
            </div>
        </div>
    </div>
</div>
}

@* Spells *@
@if (ActiveTab == "Magias")
{
<div class="dnd-sheet">

    <div class="spell-header-box">
        <div class="dnd-field">
            <input type="text" value="@V("conj_atributo")" @onchange='e=>S("conj_atributo",e.Value)' placeholder="Carisma" />
            <label>Atributo de Conjuração</label>
        </div>
        <div class="dnd-field">
            <input type="number" value="@V("conj_mod")" @onchange='e=>S("conj_mod",e.Value)' />
            <label>Mod. de Atributo</label>
        </div>
        <div class="dnd-field">
            <input type="number" value="@V("conj_cd")" @onchange='e=>S("conj_cd",e.Value)' />
            <label>CD para Evitar Magia</label>
        </div>
        <div class="dnd-field">
            <input type="number" value="@V("conj_bonus_atq")" @onchange='e=>S("conj_bonus_atq",e.Value)' />
            <label>Bônus de Ataque Mágico</label>
        </div>
    </div>

    <div class="spell-slots-block">
        <div class="spell-slots-title">Espaços de Magia</div>
        <div class="spell-slots-grid">
            @foreach (var circle in SlotCircles)
            {
                var total  = IZero($"slots_{circle}_total");
                var gastos = IZero($"slots_{circle}_gastos");
                <div class="spell-slot-col">
                    <div class="spell-slot-circle-label">@circle°</div>
                    <div class="spell-slot-row">
                        <input type="number" min="0" max="@(circle == 1 ? 4 : 3)"
                               value="@total" @onchange='e=>S($"slots_{circle}_total", e.Value)' />
                        <span class="spell-slot-sep">/</span>
                        <input type="number" min="0" max="@(circle == 1 ? 4 : 3)"
                               value="@gastos" @onchange='e=>S($"slots_{circle}_gastos", e.Value)' />
                    </div>
                    <div class="spell-slot-pips">
                        @for (int p = 0; p < Math.Min(Math.Max(total,0), circle==1?4:3); p++)
                        {
                            var pip = p;
                            <span class="spell-pip @(pip < gastos ? "used" : "")"></span>
                        }
                    </div>
                    <div class="spell-slot-sublabel">total / gastos</div>
                </div>
            }
        </div>
    </div>

    <div class="spell-list-title">
        <span>Truques e Magias Preparadas</span>
        <button class="btn-add-spell" @onclick="AddSpell">+ Adicionar Magia</button>
    </div>

    @for (int i = 0; i < Spells.Count; i++)
    {
        var idx = i;
        var sp  = Spells[idx];
        <div class="spell-card @(sp.Expanded ? "is-open" : "")">
            <div class="spell-card-top">
                <div class="spell-badge-circle">
                    <input type="number" min="0" max="9" value="@sp.Circulo"
                           @onchange='e=>sp.Circulo=int.TryParse(e.Value?.ToString(),out var n)?n:0' />
                    <span>círc.</span>
                </div>
                <input class="spell-input-name" type="text" value="@sp.Nome"
                       @onchange='e=>sp.Nome=e.Value?.ToString()??""' placeholder="Nome da magia" />
                <input class="spell-input-school" type="text" value="@sp.Escola"
                       @onchange='e=>sp.Escola=e.Value?.ToString()??""' placeholder="Escola" />
                <div class="spell-flags">
                    <span class="spell-flag @(sp.Concentracao?"on":"")" @onclick='()=>sp.Concentracao=!sp.Concentracao' title="Concentração">C</span>
                    <span class="spell-flag @(sp.Ritual?"on":"")"       @onclick='()=>sp.Ritual=!sp.Ritual'             title="Ritual">R</span>
                    <span class="spell-flag @(sp.Material?"on":"")"     @onclick='()=>sp.Material=!sp.Material'         title="Material">M</span>
                </div>
                <button class="spell-expand-btn" @onclick="()=>sp.Expanded=!sp.Expanded">
                    @(sp.Expanded ? "▲ Recolher" : "▼ Detalhes")
                </button>
                <button class="spell-del-btn" @onclick='()=>Spells.RemoveAt(idx)'>✕</button>
            </div>
            @if (sp.Expanded)
            {
                <div class="spell-card-body">
                    <div class="spell-meta-grid">
                        <div class="spell-meta-field">
                            <label>Tempo de Conjuração</label>
                            <input type="text" value="@sp.TempoCast" @onchange='e=>sp.TempoCast=e.Value?.ToString()??""' placeholder="1 Ação" />
                        </div>
                        <div class="spell-meta-field">
                            <label>Alcance</label>
                            <input type="text" value="@sp.Alcance" @onchange='e=>sp.Alcance=e.Value?.ToString()??""' placeholder="9 m" />
                        </div>
                        <div class="spell-meta-field">
                            <label>Duração</label>
                            <input type="text" value="@sp.Duracao" @onchange='e=>sp.Duracao=e.Value?.ToString()??""' placeholder="Instantânea" />
                        </div>
                        <div class="spell-meta-field">
                            <label>Componentes / Material</label>
                            <input type="text" value="@sp.Componentes" @onchange='e=>sp.Componentes=e.Value?.ToString()??""' placeholder="V, S, M..." />
                        </div>
                        <div class="spell-meta-field">
                            <label>Dano / Efeito Principal</label>
                            <input type="text" value="@sp.DanoEfeito" @onchange='e=>sp.DanoEfeito=e.Value?.ToString()??""' placeholder="2d8 fogo..." />
                        </div>
                    </div>
                    <div class="spell-desc-block">
                        <label class="spell-desc-label">Descrição Completa</label>
                        <textarea class="spell-desc-area" @bind="sp.Descricao" @bind:event="oninput" rows="5"
                                  placeholder="Cole aqui a descrição do livro..."></textarea>
                    </div>
                </div>
            }
        </div>
    }

    @if (Spells.Count == 0)
    {
        <div class="spell-empty">
            Nenhuma magia adicionada ainda.<br />
            Clique em <strong>+ Adicionar Magia</strong> para começar.
        </div>
    }
</div>
}

@* Equipment *@
@if (ActiveTab == "Equipamentos")
{
<div class="dnd-sheet">
    <div class="dnd-row-2" style="margin-bottom:1rem;">
        <div class="dnd-section-box">
            <label class="dnd-section-label">Moedas</label>
            <div class="dnd-coins">
                @foreach (var coin in new[]{("PC","pc"),("PP","pp"),("CE","ce"),("PO","po"),("PL","pl")})
                {
                    <div class="dnd-coin">
                        <input type="number" value="@V(coin.Item2)" @onchange='e=>S(coin.Item2,e.Value)' />
                        <label>@coin.Item1</label>
                    </div>
                }
            </div>
        </div>
        <div class="dnd-section-box">
            <label class="dnd-section-label">Itens Mágicos Sintonizados</label>
            @for (int i = 0; i < 3; i++) { var idx = i;
                <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;">
                    <span style="color:#9a7c2a;font-size:0.8rem;">✦</span>
                    <input type="text" value="@V($"sintonizado_{idx}")"
                           @onchange='e=>S($"sintonizado_{idx}",e.Value)'
                           placeholder="Item sintonizado..." style="flex:1;" />
                </div>
            }
        </div>
    </div>

    <div class="dnd-section-box">
        <div style="display:flex;justify-content:space-between;align-items:center;">
            <label class="dnd-section-label" style="margin-bottom:0;">Equipamentos</label>
            <button class="btn-add-spell" style="margin:0;" @onclick="AddItem">+ Item</button>
        </div>
        <div class="eq-list-header">
            <span style="flex:2">Item / Habilidade</span>
            <span style="flex:1">Qtd / Usos</span>
            <span style="flex:2">Efeito / Função</span>
            <span style="flex:2">Regras Mecânicas</span>
            <span style="flex:1">Notas</span>
            <span style="width:28px">Cons.</span>
            <span style="width:30px"></span>
        </div>
        @for (int i = 0; i < Items.Count; i++) { var idx = i; var it = Items[idx];
            <div class="eq-row">
                <input type="text" value="@it.Nome"     @onchange='e=>it.Nome=e.Value?.ToString()??""'     placeholder="Nome..." />
                <input type="text" value="@it.Qtd"      @onchange='e=>it.Qtd=e.Value?.ToString()??""'      placeholder="1" />
                <input type="text" value="@it.Efeito"   @onchange='e=>it.Efeito=e.Value?.ToString()??""'   placeholder="Efeito..." />
                <input type="text" value="@it.Mecanica" @onchange='e=>it.Mecanica=e.Value?.ToString()??""' placeholder="Dano, CD..." />
                <input type="text" value="@it.Notas"    @onchange='e=>it.Notas=e.Value?.ToString()??""'    placeholder="Notas..." />
                <span class="spell-check @(it.Consumivel?"on":"")" @onclick='()=>it.Consumivel=!it.Consumivel'>✓</span>
                <button class="spell-del" @onclick='()=>Items.RemoveAt(idx)'>✕</button>
            </div>
        }
    </div>

    <div class="dnd-row-2" style="margin-top:1rem;">
        <div class="dnd-section-box dnd-grow">
            <label class="dnd-section-label">Idiomas</label>
            <textarea class="dnd-textarea-grow" @bind="IdiomasValue" @bind:event="oninput" placeholder="Comum, Élfico..."></textarea>
        </div>
        <div class="dnd-section-box dnd-grow">
            <label class="dnd-section-label">Aparência</label>
            <textarea class="dnd-textarea-grow" @bind="AparenciaValue" @bind:event="oninput" placeholder="Descreva a aparência..."></textarea>
        </div>
        <div class="dnd-section-box dnd-grow">
            <label class="dnd-section-label">História e Personalidade</label>
            <textarea class="dnd-textarea-grow" @bind="HistoriaValue" @bind:event="oninput" placeholder="Backstory, traços, ideais, laços, fraquezas..."></textarea>
        </div>
    </div>
</div>
}

@* CSS *@
<style>
    .sheet-tabs { display:flex; gap:4px; margin-bottom:1rem; border-bottom:2px solid #c9a84c; }
    .sheet-tab {
        font-family:'Cinzel',serif; font-size:0.72rem; font-weight:600;
        letter-spacing:0.08em; text-transform:uppercase;
        padding:0.45rem 1.25rem; background:transparent;
        border:1px solid #9a7c2a; border-bottom:none;
        border-radius:4px 4px 0 0; color:#6b4c28; cursor:pointer; transition:all 0.15s;
    }
    .sheet-tab.active, .sheet-tab:hover { background:#c9a84c; color:#1c1008; }

    .dnd-sheet {
        background:#f5ead6; border:2px solid #c9a84c; border-radius:0 8px 8px 8px;
        padding:1rem; color:#1c1008; font-family:'Crimson Text',serif;
        box-shadow:0 4px 20px rgba(0,0,0,0.4);
    }

